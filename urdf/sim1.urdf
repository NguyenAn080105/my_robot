<?xml version="1.0" ?>
<robot name="my_robot">

  <!-- Laser (LiDAR) -->
  <joint name="laser_joint" type="fixed">
    <parent link="chassis"/>
    <child link="laser_frame"/>
    <origin rpy="0 0 0" xyz="-0.04625 0 0.135"/>
  </joint>
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="7.58e-05" ixy="0" ixz="0" iyy="0.000125" iyz="0" izz="7.585e-05"/>
    </inertial>
  </link>

  <gazebo reference="laser_frame">
    <material>Gazebo/Black</material>
    <sensor name="lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>12</max>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_laser.so" name="gazebo_ros_laser">
        <topicName>scan</topicName>
        <frameName>laser_frame</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </visual>
    <material name="blue">
      <color rgba="0 0 1 1.0"/>
    </material>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
   <material>Gazebo/Blue</material>
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>__default_topic__</topic>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <topicName>imu</topicName>
        <bodyName>imu_link</bodyName>
        <updateRateHZ>10.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>imu_link</frameName>
        <initialOrientationAsReference>false</initialOrientationAsReference>
      </plugin>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

  <!-- CAMERA -->
  <link name="camera_link">
    <visual name="camera_body_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.094 0.029"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    
    <visual name="camera_lens_visual">
      <origin xyz="0.015 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.005"/>
      </geometry>
      <material name="black_lens">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.005 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.096 0.031"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.15"/> <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.000006" iyz="0" izz="0.00004"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="0.1045 0 0.1055" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <gazebo reference="camera_link">
    <material>Gazebo/DarkGrey</material>
    <sensor type="camera" name="camera1">
      <update_rate>30.0</update_rate>

      <pose>0.03 0 0 0 0 0</pose> 

      <camera name="head">
      <horizontal_fov>1.5707</horizontal_fov> 
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>my_robot/camera1</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_optical_link</frameName> <hackBaseline>0.07</hackBaseline>
        <distortionK1>0.0</distortionK1>
        <distortionK2>0.0</distortionK2>
        <distortionK3>0.0</distortionK3>
        <distortionT1>0.0</distortionT1>
        <distortionT2>0.0</distortionT2>
      </plugin>
    </sensor>
  </gazebo>

  <!--height_box = height_total(27) - wheel_radius - LiDAR-->
  <!-- Base link -->
  <link name="base_link">
  </link>
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.152"/>
  </joint>

  <!-- CHASSIS -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0"/>
  </joint>
  <link name="chassis">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.185 0.166 0.24"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.185 0.166 0.24"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.4"/>
      <inertia ixx="0.031" ixy="0" ixz="0" iyy="0.034" iyz="0" izz="0.022"/>
    </inertial>
  </link>

  <!-- WHEEL LINKS -->
  <!-- FRONT WHEELS -->
  <link name="left_front_wheel">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/> 
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <link name="right_front_wheel">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- REAR WHEELS -->
  <link name="left_rear_wheel">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <link name="right_rear_wheel">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <!-- WHEEL JOINTS -->
  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0.0925 0.0955 -0.12"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin rpy="1.5707963267948966 0 0" xyz="0.0925 -0.0955 -0.12"/>
    <axis xyz="0 0 -1"/>
  </joint>
  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="-0.0925 0.0955 -0.12"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin rpy="1.5707963267948966 0 0" xyz="-0.0925 -0.0955 -0.12"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- GAZEBO -->
  <gazebo reference="laser_frame">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="chassis">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="right_front_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>0.01</mu2>
    <kp>10000000.0</kp> 
    <kd>1.0</kd>
    <minDepth>0.005</minDepth>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="left_front_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>0.01</mu2>
    <kp>10000000.0</kp> 
    <kd>1.0</kd>
    <minDepth>0.005</minDepth>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="left_rear_wheel">
    <material>Gazebo/Black</material>
    <mu1>50.0</mu1> 
    <mu2>50.0</mu2> 
    <kp>10000000.0</kp> 
    <kd>1.0</kd>
    <minDepth>0.005</minDepth>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  
  <gazebo reference="right_rear_wheel">
    <material>Gazebo/Black</material>
    <mu1>50.0</mu1> 
    <mu2>50.0</mu2> 
    <kp>10000000.0</kp> 
    <kd>1.0</kd>
    <minDepth>0.005</minDepth>
    <fdir1>1 0 0</fdir1> 
  </gazebo>

  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="diff_drive">
      <updateRate>50</updateRate>
      <leftJoint>left_rear_wheel_joint</leftJoint>
      <rightJoint>right_rear_wheel_joint</rightJoint>
      <wheelSeparation>0.191</wheelSeparation>
      <wheelDiameter>0.064</wheelDiameter>
      <wheelAcceleration>1.0</wheelAcceleration>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>

      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom/wheel</odometryTopic> 
      
      <publishOdomTF>false</publishOdomTF> 
      <publishWheelTF>false</publishWheelTF>

      <odometrySource>encoder</odometrySource> 
      <publishOdom>true</publishOdom>
      <publishWheelJointState>false</publishWheelJointState>
      <wheelTorque>5</wheelTorque>
      <rosDebugLevel>na</rosDebugLevel>
      <publishTf>true</publishTf>
      <tf_prefix></tf_prefix>
    </plugin>

    <plugin filename="libgazebo_ros_joint_state_publisher.so" name="joint_state_publisher">
      <updateRate>50</updateRate>
      <jointName>left_front_wheel_joint,right_front_wheel_joint,left_rear_wheel_joint,right_rear_wheel_joint</jointName>
    </plugin>
  </gazebo>
</robot>